diff --git a/api/src/utils/request-id.ts b/api/src/utils/request-id.ts
new file mode 100644
index 0000000000..3b6b58d664
--- /dev/null
+++ b/api/src/utils/request-id.ts
@@ -0,0 +1,18 @@
+import { nanoid } from 'nanoid';
+
+export const REQUEST_ID_HEADER = 'X-Request-Id';
+
+const VALID_PATTERN = /^[A-Za-z0-9._-]+$/;
+const MAX_LENGTH = 200;
+
+export function isValidRequestId(value: string | undefined | null): value is string {
+  if (!value || value.length === 0 || value.length > MAX_LENGTH) return false;
+  return VALID_PATTERN.test(value);
+}
+
+export function resolveRequestId(headers: Record<string, string | string[] | undefined>): string {
+  const value = headers[REQUEST_ID_HEADER.toLowerCase()];
+  const str = Array.isArray(value) ? value[0] : value;
+
+return isValidRequestId(str) ? str : nanoid();
+}
