diff --git a/api/src/middleware/request-id.ts b/api/src/middleware/request-id.ts
new file mode 100644
index 0000000000..68611e45d6
--- /dev/null
+++ b/api/src/middleware/request-id.ts
@@ -0,0 +1,11 @@
+import type { RequestHandler } from 'express';
+import { nanoid } from 'nanoid';
+import { REQUEST_ID_HEADER, isValidRequestId } from '../utils/request-id.js';
+
+export const requestIdMiddleware: RequestHandler = (req, res, next) => {
+  const incoming = req.headers[REQUEST_ID_HEADER.toLowerCase()] as string | undefined;
+  const requestId = isValidRequestId(incoming) ? incoming : nanoid();
+  res.setHeader(REQUEST_ID_HEADER, requestId);
+  (req as any).id = requestId;
+  next();
+};
